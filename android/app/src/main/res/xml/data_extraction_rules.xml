<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup policy for Scope (Android 12+, API 31+).
  No app-specific exclusions: the app stores only non-sensitive WebView
  localStorage settings (theme, sensitivity, smoothing, FFT, mic toggle).
  Including them in cloud-backup and device-transfer means the user's
  preferences carry between reinstalls and device migrations, matching
  the user expectation for a settings-only app.
-->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
