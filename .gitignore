.playwright-mcp
oscilloscope.code-workspace

# Capacitor / Android
node_modules/
android/.gradle/
android/.idea/
android/app/build/
android/build/
android/local.properties
android/gradle.properties
android/app/release/
*.keystore
*.jks

# Generated by sync-www.sh
www/

# Electron output
dist/

# Code-signing artefacts — private keys + .pfx must never be committed.
# The repository convention is for these to live in ~/.scope-signing/
# outside the repo; these patterns are belt-and-braces for stray copies.
*.pfx
*.key
scope-signing.crt

# Playwright + ad-hoc test output
test-results/

# Session handoff notes - local-only working state, not for the repo
docs/HANDOFF-*.md

# Working artefacts - kept local, never committed (see CLAUDE.md "Git is for code")
CLAUDE.md
docs/evidence/
docs/plans/
docs/superpowers/specs/

# Google Play submission scratch artefacts - kept local, never committed.
# play-listing/ holds screenshots, feature graphic, TV banner, etc.
# that get uploaded to the Play Console rather than living in the
# source tree. docs/privacy-policy.md is intentionally NOT ignored -
# it is the one Play document the public Play listing links to and
# therefore needs a public URL in this repo.
play-listing/
